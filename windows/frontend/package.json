{
  "name": "snowden-system-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "snowden.system — Windows UI (Wails). Показывает только факты; нет данных — «нет данных».",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check": "npm run test:types && npm run test && npm run build && npm run test:browser",
    "test:types": "vue-tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
